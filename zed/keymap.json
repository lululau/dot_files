  // - <leader>oes: ~/Documents/materials/demo/demo.sh
  // - <leader>oeS: ~/Documents/materials/demo/demo.swift
  // - <leader>oep: ~/Documents/materials/demo/demo.pl
  // - <leader>oeo: ~/Documents/materials/demo/demo.org
  // - <leader>oem: ~/Documents/materials/demo/demo.md
