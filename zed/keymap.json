  // - <leader>oey: ~/Documents/materials/demo/demo.yaml
  // - <leader>oeH: ~/Documents/materials/demo/demo.html
  // - <leader>oec: ~/Documents/materials/demo/demo.c
  // - <leader>oeg: ~/cascode/go/src/demo/demo.go
  // - <leader>oeq: ~/Documents/materials/demo/demo.sql
  // - <leader>oeE: ~/Documents/materials/demo/demo.exs
  // - <leader>oee: ~/Documents/materials/demo/demo.es
  // - <leader>oek: ~/Documents/materials/demo/demo.hs
  // - <leader>oex: ~/Documents/materials/mind-wave-chats/default.chat
  // - <leader>oet: ~/Documents/materials/demo/demo.txt

  // ============================================================================
  // VIM NORMAL MODE - DIRECTORY NAVIGATION (<leader>od prefix)
  // ============================================================================
  // NOTE: All these bindings use yazi terminal integration (UNAVAILABLE)
  // Use project panel, terminal, or file finder instead
  // Paths from Cursor config for reference:
  // - <leader>odd: ~/Downloads
  // - <leader>odA: /Applications/
  // - <leader>odb: ~/blog/
  // - <leader>odB: ~/bin/
  // - <leader>odC: ~/Cafe/
  // - <leader>odc: ~/.config/
  // - <leader>odC-c: ~/cascode/
  // - <leader>odD: ~/Documents/
  // - <leader>odf: ~/.fzf/
  // - <leader>odg: ~/cascode/github.com/
  // - <leader>odH: /home
  // - <leader>odh: ~/
  // - <leader>odi: ~/Library/Mobile Documents/com~apple~CloudDocs/
  // - <leader>odk: ~/sd/
  // - <leader>odK: ~/kt/
  // - <leader>odl: ~/Library/Application Support/
  // - <leader>odL: ~/Library/Preferences/
  // - <leader>odM: ~/Movies/
  // - <leader>odm: ~/Documents/materials/
  // - <leader>ods: ~/Documents/materials/scratches/
  // - <leader>odS: ~/snips/
  // - <leader>odC-s: ~/Documents/materials/snippets
  // - <leader>ode: ~/.spacemacs.d/
  // - <leader>odz: ~/.spacezsh/
  // - <leader>odZ: ~/.oh-my-zsh/
  // - <leader>od/: /
  // - <leader>odo: ~/Library/Mobile Documents/iCloud~com~appsonthemove~beorg/Documents/org
  // - <leader>odO: /Users/liuxiang/Obsidian/Documents/Main
  // - <leader>odj: ~/Documents/materials/journal
  // - <leader>odJ: ~/Documents/materials/jira
  // - <leader>odn: ~/Documents/materials/notes
  // - <leader>odN: ~/Documents/evernotes
  // - <leader>odw: ~/Documents/materials/webclips
  // - <leader>odv: /Volumes
  // - <leader>odT: ~/.tmux
  // - <leader>odt: ~/tmp/

  // ============================================================================
  // VIM NORMAL MODE - DOCKER (<leader>dk)
  // ============================================================================
  // NOTE: Docker command (fdkc) uses command-bridge terminal (UNAVAILABLE)
  // Create as Zed task or run in terminal instead

  // ============================================================================
  // NON-VIM CONTEXTS - Continue from existing keybindings
  // ============================================================================

  // Multi-line movement in insert mode (already included above)

  // ============================================================================
  // TAB & EDITOR GROUP NAVIGATION
  // ============================================================================
  {
    "context": "Workspace",
    "bindings": {
      // Switch to specific tabs
      "cmd-1": ["pane::ActivateItem", 0],
      "cmd-2": ["pane::ActivateItem", 1],
      "cmd-3": ["pane::ActivateItem", 2],
      "cmd-4": ["pane::ActivateItem", 3],
      "cmd-5": ["pane::ActivateItem", 4],
      "cmd-6": ["pane::ActivateItem", 5],
      "cmd-7": ["pane::ActivateItem", 6],
      "cmd-8": ["pane::ActivateItem", 7],
      "cmd-9": ["pane::ActivateItem", 8],

      // Focus project panel
      "cmd-0": "project_panel::ToggleFocus",

      // Navigate between tabs
      "alt-tab": "pane::ActivateNextItem",
      "alt-`": "pane::ActivatePrevItem"
    }
  },

  // ============================================================================
  // SPLIT / PANE NAVIGATION
  // ============================================================================
  {
    "context": "Workspace",
    "bindings": {
      // Focus specific panes/groups
      "alt-0": "project_panel::ToggleFocus",
      "alt-1": ["workspace::ActivatePaneInDirection", "Left"],
      "alt-2": ["workspace::ActivatePaneInDirection", "Right"],
      "alt-3": ["workspace::ActivatePaneInDirection", "Down"]
    }
  },

  {
    "context": "Editor",
    "bindings": {
      // Navigate between splits
      "alt-h": ["workspace::ActivatePaneInDirection", "Left"],
      "alt-l": ["workspace::ActivatePaneInDirection", "Right"],
      "alt-k": ["workspace::ActivatePaneInDirection", "Up"]
    }
  },

  // ============================================================================
  // SIDEBAR & PANEL TOGGLES
  // ============================================================================
  {
    "context": "Workspace",
    "bindings": {
      // Toggle sidebar
      "f1": "workspace::ToggleLeftDock",

      // Toggle panel/terminal
      "cmd-'": "terminal_panel::ToggleFocus",

      // Close editor
      "cmd-w": "pane::CloseActiveItem",

      // Close all editors
      "ctrl-x ctrl-c": "pane::CloseAllItems",

      // Close other editors
      "ctrl-x ctrl-k": "pane::CloseInactiveItems",

      // Maximize editor group
      "shift-cmd-enter": "workspace::ToggleCenteredLayout",

      // Toggle auxiliary bar
      "f12": "workspace::ToggleRightDock"
    }
  },

  // ============================================================================
  // TERMINAL INTEGRATION
  // ============================================================================
  {
    "context": "Terminal",
    "bindings": {
      // Send Ctrl-Z to terminal
      "cmd-q": ["terminal::SendText", "\\u001a"],

      // Navigate between terminal tabs
      "cmd-]": "pane::ActivateNextItem",
      "cmd-[": "pane::ActivatePrevItem",

      // Close terminal
      "cmd-w": "workspace::ToggleBottomDock",

      // Terminal suggestion navigation
      "ctrl-n": "menu::SelectNext",
      "ctrl-p": "menu::SelectPrev"
    }
  },

  // ============================================================================
  // GIT OPERATIONS (non-vim)
  // ============================================================================
  {
    "context": "Workspace",
    "bindings": {
      // Git blame toggle
      "cmd-g": "editor::ToggleGitBlame",

      // Generate commit message with AI
      "alt-\\": "assistant::InlineAssist",
      "cmd-\\": "assistant::InlineAssist"
    }
  },

  // ============================================================================
  // PROJECT PANEL & FILE EXPLORER
  // ============================================================================
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      // Rename file
      "cmd-enter": "project_panel::Rename",
      "shift-cmd-r": "project_panel::Rename",

      // Navigate in project panel
      "tab": "project_panel::ExpandSelectedEntry",
      "u": "project_panel::CollapseSelectedEntry",
      "enter": "project_panel::Open"
    }
  },

  // ============================================================================
  // SEARCH & REPLACE
  // ============================================================================
  {
    "context": "Workspace",
    "bindings": {
      // Project-wide search
      "shift-cmd-/": "pane::DeploySearch",

      // Search for selection
      "shift-cmd-8": ["workspace::SendKeystrokes", "cmd-c shift-cmd-f cmd-v"]
    }
  },

  // ============================================================================
  // INLINE ASSIST & AI FEATURES
  // ============================================================================
  {
    "context": "Editor",
    "bindings": {
      // Inline assistant
      "cmd-i": "assistant::InlineAssist",

      // Accept partial suggestion
      "shift-tab": "editor::AcceptPartialCopilotSuggestion",
      "alt-f": "editor::AcceptPartialCopilotSuggestion",

      // Generate with AI
      "shift-alt-enter": "assistant::InlineAssist"
    }
  },

  {
    "context": "AssistantPanel || Assistant",
    "bindings": {
      // New chat/composer
      "cmd-n": "assistant::Assist",
      "cmd-t": "assistant::Assist",

      // Emacs-like navigation
      "ctrl-a": "editor::MoveToBeginningOfLine",
      "ctrl-e": "editor::MoveToEndOfLine",
      "ctrl-f": "editor::MoveRight",
      "ctrl-k": "editor::DeleteToEndOfLine",
      "ctrl-d": "editor::Delete",
      "ctrl-p": "menu::SelectPrev",
      "ctrl-n": "menu::SelectNext",
      "alt-f": "editor::MoveToNextWordEnd",
      "alt-d": "editor::DeleteToNextWordEnd"
    }
  },

  // ============================================================================
  // AUTOCOMPLETE & SUGGESTIONS
  // ============================================================================
  {
    "context": "Editor && showing_completions",
    "bindings": {
      // Accept completion
      "cmd-enter": "editor::ConfirmCompletion",

      // Navigate completions
      "ctrl-n": "editor::ContextMenuNext",
      "ctrl-p": "editor::ContextMenuPrev"
    }
  },

  {
    "context": "Editor",
    "bindings": {
      // Trigger completion
      "alt-/": "editor::ShowCompletions",

      // Format document
      "shift-alt-f": "editor::Format"
    }
  },

  // ============================================================================
  // WORKSPACE & WINDOW MANAGEMENT
  // ============================================================================
  {
    "context": "Workspace",
    "bindings": {
      // Toggle centered layout
      "shift-cmd-enter": "workspace::ToggleCenteredLayout",

      // Switch project/workspace
      "cmd-p cmd-p": "workspace::Open",
      "cmd-p cmd-w": "workspace::Open",
      "cmd-p cmd-o": "workspace::Open",

      // Select all
      "cmd-a cmd-a": "editor::SelectAll"
    }
  },
  {
    "bindings": {
      "cmd-o": "file_finder::Toggle"
    }
  }
]
